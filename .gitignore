# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.pyo

# Virtual environments
.venv/
venv/
env/

# Local config & secrets — NEVER commit these
.env
config/credentials.yaml
config/schwab_tokens.json
# Wildcard, not just the exact name: a hand-made backup such as
# schwab_tokens.json.bak-11aug does NOT match the bare filename and
# would be staged by `git add -A`. That is how OAuth tokens reached a
# previous repository's history.
config/schwab_tokens.json*
config/credentials.yaml*

# Rithmic credential files
*.ini
*.pem
*.key

# Data files — too large / user-specific
data/historical/
data/live/
# Saved backtest results. Inside /app/data, which docker-compose mounts as
# the named volume autotrader-data, so these survive a redeploy on the server.
data/backtests/

# Logs
logs/
*.log

# Test/coverage artifacts
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.bandit_cache/
# .pytest_cache was missing while its two siblings were listed, so it was the one
# cache directory that kept appearing in `git status` and in the editor's file
# tree. Nothing distinguishes it from the others -- it is regenerated by every
# test run.
.pytest_cache/

# Generated reports — share via email/Slack, don't commit
reports/*.html

# Streamlit cache
.streamlit/cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Screenshots and scratch images dropped into the working copy while debugging.
# One (image.png, a screenshot of the editor's own file tree) was committed-by-
# accident material sitting untracked for a day. Name them deliberately if one is
# ever meant to be kept -- docs/assets/ is where images that belong here live.
image.png
screenshot*.png
Screenshot*.png
