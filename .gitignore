# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.pyo

# Virtual environments
.venv/
venv/
env/

# Local config & secrets — NEVER commit these
.env
config/credentials.yaml
config/schwab_tokens.json

# Rithmic credential files
*.ini
*.pem
*.key

# Data files — too large / user-specific
data/historical/
data/live/

# Logs
logs/
*.log

# Test/coverage artifacts
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Generated reports — share via email/Slack, don't commit
reports/*.html

# Generated benchmark/validation data (regeneratable via `elliott benchmark`
# / validation/populate.py; consistent with data/historical/ above -- too
# large and derived to belong in git history). Source code in benchmark/
# and validation/ IS committed; only their generated output is excluded.
benchmark/charts/
benchmark/*.db
benchmark/exports/
benchmark/dashboard.html
benchmark/discrepancy_report.html
validation/charts/
validation/*.db
validation/dashboard.html

# Streamlit cache
.streamlit/cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
