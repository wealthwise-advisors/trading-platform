# AutoTrader — Credentials Template
#
# SETUP:
#   1. Copy this file to credentials.yaml  (same directory)
#   2. Fill in your values
#   3. credentials.yaml is gitignored — never commit it
#
# ALTERNATIVE — use a .env file in the project root:
#   RITHMIC_CREDENTIALS_PATH=/path/to/your/rithmic/credentials
#
# OR set the system environment variable RITHMIC_CREDENTIALS_PATH.

rithmic:
  # Path to the directory that contains your RITHMIC_LIVE.ini file.
  # The rithmic package reads credentials from this directory automatically.
  #
  # Windows example:  C:\Users\YourName\rithmic_credentials
  # macOS / Linux:    /home/yourname/rithmic_credentials
  credentials_path: ""
