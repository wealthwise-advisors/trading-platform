# AutoTrader -- environment variables (Task 10 release audit).
# Copy to .env and fill in as needed. Nothing here is required for
# synthetic-data backtesting, replay, or the Elliott Wave engine to run --
# these only matter for the optional integrations they name.

# Comma-separated list of origins the API will accept browser requests
# from (FastAPI CORSMiddleware, api/main.py). The default covers the Vite
# dev server (5173) and a common alt dev port (3000). docker-compose.yml
# overrides this to the nginx-served frontend's origin in production.
AUTOTRADER_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Alternative to config/credentials.yaml's rithmic.credentials_path --
# either works, this one is convenient in Docker/CI where mounting a whole
# credentials directory is simpler via one env var.
# RITHMIC_CREDENTIALS_PATH=/path/to/rithmic/credentials

# Schwab OAuth2 app credentials are read from config/credentials.yaml (see
# config/credentials.yaml.example), not from environment variables -- the
# schwabdev client library expects a tokens FILE it can read/write across
# restarts, which doesn't fit an env-var model. Mount config/ read-write
# (not read-only) if you need the API to persist a refreshed token file
# inside the container.
