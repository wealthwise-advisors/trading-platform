# AutoTrader -- environment variables (Task 10 release audit).
# Copy to .env and fill in as needed. Nothing here is required for
# synthetic-data backtesting or replay to run -- these only matter for the
# optional integrations they name.

# Comma-separated list of origins the API will accept browser requests
# from (FastAPI CORSMiddleware, api/main.py). The default covers the Vite
# dev server (5173) and a common alt dev port (3000). docker-compose.yml
# overrides this to the nginx-served frontend's origin in production.
AUTOTRADER_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Explicit override for where config/ lives (src/config.py's
# resolve_config_dir()). Only needed if neither the current working
# directory nor a package-relative guess finds it -- e.g. a custom
# deployment layout. Normal dev (repo root) and the default Docker image
# (WORKDIR /app, config/ mounted at /app/config) both find config/
# automatically without setting this.
# AUTOTRADER_CONFIG_DIR=/path/to/config

# Alternative to config/credentials.yaml's rithmic.credentials_path --
# either works, this one is convenient in Docker/CI where mounting a whole
# credentials directory is simpler via one env var.
# RITHMIC_CREDENTIALS_PATH=/path/to/rithmic/credentials

# Schwab OAuth2 app credentials are read from config/credentials.yaml (see
# config/credentials.yaml.example), not from environment variables -- the
# schwabdev client library expects a tokens FILE it can read/write across
# restarts, which doesn't fit an env-var model. Mount config/ read-write
# (not read-only) if you need the API to persist a refreshed token file
# inside the container.

# ── OAuth sign-in: Google, LinkedIn, Twitter/X ──────────────────────────────
# All optional. Left empty, the matching provider reports itself as
# unconfigured and its button on the sign-in page says so -- that is a
# supported state, not a broken one, and nothing else changes.
#
# `py -3.12 scripts/manage_users.py oauth-status` prints which of these are
# set and the exact redirect URI to register at each provider's console.
#
# OAuth NEVER creates an account. It is a second way into an account that
# already exists; see docs/CONFIGURATION.md.

# The public origin a browser reaches this deployment on -- no trailing slash.
# It cannot be derived from the request (Host is client-supplied) and it must
# match what is registered at each provider character for character.
#   local dev via scripts/run_local.py:  http://127.0.0.1:8800
# AUTOTRADER_PUBLIC_BASE_URL=https://your-host

# Google Cloud console -> Credentials -> OAuth 2.0 Client ID (Web application).
# AUTOTRADER_GOOGLE_CLIENT_ID=
# AUTOTRADER_GOOGLE_CLIENT_SECRET=

# LinkedIn Developers -> your app -> Products -> add
# "Sign In with LinkedIn using OpenID Connect", then Auth -> keys.
# AUTOTRADER_LINKEDIN_CLIENT_ID=
# AUTOTRADER_LINKEDIN_CLIENT_SECRET=

# X developer portal -> your app -> User authentication settings ->
# OAuth 2.0, app type "Web App" (a CONFIDENTIAL client -- a public one has no
# secret and will not work here).
#
# X returns no email address at any scope, so it cannot find an account on its
# own. Link it by hand before it will let anyone in:
#   py -3.12 scripts/manage_users.py link <user> --provider twitter --subject <id>
# AUTOTRADER_TWITTER_CLIENT_ID=
# AUTOTRADER_TWITTER_CLIENT_SECRET=

# Apple is deliberately not supported: "Sign in with Apple" needs a paid Apple
# Developer Program membership and an ES256-signed JWT built from a .p8 key
# rather than a client secret. Its button keeps the "not connected yet"
# notice. See the module docstring in api/oauth.py for what adding it needs.
